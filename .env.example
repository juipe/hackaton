# Skladchina («Складчина») - environment template
#
# Copy this file to .env in the repository root before starting the stack:
#
#   cp .env.example .env
#   docker compose up --build
#
# Docker Compose reads .env from the directory holding docker-compose.yml and
# passes these through to the containers. To run the API directly on your own
# machine instead, put the same file at backend/.env - that is where
# pydantic-settings looks when uvicorn is started from backend/.
#
# Every value below is a working local-development default. The only one you
# must change before exposing Skladchina to anyone is SECRET_KEY.


# ---------------------------------------------------------------------------
# Postgres container
# ---------------------------------------------------------------------------
# Read by the official postgres image, which creates this role and database on
# first boot only. Changing them later needs a fresh volume, and they must stay
# consistent with DATABASE_URL below.
POSTGRES_DB=skladchina
POSTGRES_USER=skladchina
POSTGRES_PASSWORD=skladchina


# ---------------------------------------------------------------------------
# Published host ports
# ---------------------------------------------------------------------------
# The ports docker-compose.yml publishes on the host. Inside the Compose network
# the services keep their own ports (5432, 8000, 80) whatever you set here.
# Postgres defaults to 5433 because a locally installed Postgres almost always
# holds 5432. Change FRONTEND_PORT together with FRONTEND_BASE_URL and
# CORS_ORIGINS below, otherwise invite links point at the wrong address.
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000


# ---------------------------------------------------------------------------
# Backend - database
# ---------------------------------------------------------------------------
# SQLAlchemy URL, psycopg 3 driver. Read only when you run the API yourself
# from backend/ (backend/.env): the Docker stack assembles its own URL out of
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above and ignores this line,
# so under Compose change the database credentials there, not here.
DATABASE_URL=postgresql+psycopg://skladchina:skladchina@db:5432/skladchina
# Your own PostgreSQL on localhost; use POSTGRES_PORT (5433) instead of 5432 to
# point at the database published by the Compose stack.
# DATABASE_URL=postgresql+psycopg://skladchina:skladchina@localhost:5432/skladchina


# ---------------------------------------------------------------------------
# Backend - security
# ---------------------------------------------------------------------------
# Signs the session JWT. CHANGE THIS: anyone who knows the value can mint a
# session for any account. Generate a fresh one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-please-32-chars-minimum

# development | production | test
ENVIRONMENT=development

# Session lifetime in minutes. Default is 7 days (60 * 24 * 7).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Send the session cookie over HTTPS only. Must be true in production; false
# locally, because a Secure cookie is dropped on plain http://localhost.
COOKIE_SECURE=false

# lax | strict | none. "none" is only honoured together with COOKIE_SECURE=true
# and is needed only when the SPA is served from a different site than the API.
COOKIE_SAMESITE=lax


# ---------------------------------------------------------------------------
# Backend - web
# ---------------------------------------------------------------------------
# Browser origins allowed to call the API with credentials. Accepts a comma
# separated list or a JSON array. Under Docker the SPA and the API share one
# origin behind nginx, so this really only matters for the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Public base URL of the SPA. Invite links are built as
# {FRONTEND_BASE_URL}/invite/{token}, so this must be the address a recipient
# can actually open. The Docker stack serves the SPA on port 3000; switch to
# 5173 only if you are running the Vite dev server instead.
FRONTEND_BASE_URL=http://localhost:3000
# FRONTEND_BASE_URL=http://localhost:5173

# How long a group invite link stays valid. Default is 14 days (24 * 14).
INVITE_EXPIRE_HOURS=336


# ---------------------------------------------------------------------------
# Backend - voice expense pipeline (local Whisper + local Ollama/Qwen)
# ---------------------------------------------------------------------------
# Both AI components run entirely on the backend machine — no external
# transcription or LLM API, no API key. See backend/app/services/whisper_service.py
# and backend/app/services/ollama_service.py.

# faster-whisper model size — bigger is more accurate and slower. One of
# tiny/base/small/medium/large-v3 (or a HF model id).
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Local Ollama server. From inside the backend's Docker container, the host's
# Ollama is reachable at host.docker.internal, not localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=120

# Rejects a voice upload above this size before it reaches Whisper.
VOICE_MAX_UPLOAD_BYTES=15728640


# ---------------------------------------------------------------------------
# Backend - container start-up (read by backend/entrypoint.sh)
# ---------------------------------------------------------------------------
# Load the demo world (users, groups, expenses, payments) after migrations, so
# a fresh stack opens on a populated dashboard. Set to 0, false, no or off for
# an empty database. The seed is idempotent, so restarts do not duplicate data.
SEED_ON_START=1

# How long to wait for Postgres before giving up: attempts, and seconds between
# them. Each attempt is itself capped at a 5 second connect timeout.
DB_WAIT_ATTEMPTS=60
DB_WAIT_INTERVAL=2


# ---------------------------------------------------------------------------
# Backend - protocol names (rarely changed)
# ---------------------------------------------------------------------------
# These are settings the API reads, but the SPA hardcodes the same three values
# in src/lib/api.ts, so changing one here alone breaks authentication. Listed
# for completeness; leave them unset unless you change both sides together.
# COOKIE_NAME=skladchina_session
# CSRF_COOKIE_NAME=skladchina_csrf
# CSRF_HEADER_NAME=X-CSRF-Token
# APP_NAME=Складчина


# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# The SPA calls the API at the same-origin path /api - proxied by Vite in
# development and by nginx in Docker - so no API base URL is needed and none is
# read. If you ever host the API on a separate origin, set this and read it in
# frontend/src/lib/api.ts.
# VITE_API_BASE_URL=http://localhost:8000/api
